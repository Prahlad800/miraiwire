{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend-miraiwire",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "keep_vars": true,
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": true},
  "vars": {
    "DATABASE_DRIVER": "turso",
    "TURSO_DATABASE_URL": "libsql://miraiwire-prahlad800.aws-ap-south-1.turso.io",
    "TURSO_DATABASE_ENGINE": "libsql",
    "SITE_NAME": "Mirai Wire",
    "RSS_ENGLISH_ONLY": "true",
    "RSS_MAX_FEEDS_PER_RUN": "1",
    "RSS_MAX_ITEMS_PER_FEED": "50"
  }
}
